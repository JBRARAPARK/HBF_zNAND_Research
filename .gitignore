.DS_Store
~$*
__pycache__/
*.pyc
.env
.env.*
.venv*/
# Preserve the original paths of the published, hash-verified experiments.
# Other local runs remain ignored.
results/local/*
!results/local/die64_pseudo_20261017/
!results/local/a1_saturated_latency_20261017/
work/
scratch/
*.pdf
*.png
*.jpg
*.jpeg

# Keep document exports and figures under version control.
!docs/**/*.pdf
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.jpeg

# Version generated evaluation figures.
!results/znand/full/*.png

!results/znand/buffer_expansion/*.png
results/znand/*_progress.log
results/znand/buffer_expansion/report_generation.log

!results/znand/locality/*.png
results/znand/locality/report_generation.log

!results/znand/buffer_growth/*.png
results/znand/buffer_growth/report_generation.log

!results/znand/head_locality/*.png
results/znand/head_locality/report_generation.log

!results/znand/scheduling_next/*.png
results/znand/scheduling_next/report_generation.log

!results/znand/pf_qd/*.png

!results/znand/host_ceiling/*.png

!results/znand/b_sequential/*.png
